@using SportStats.Models.Esports
@model EsportsPageViewModel
@{
    ViewData["Title"] = "E-sports";
    ViewData["Grupo"] = "esports";
}

<nav class="modalidades" aria-label="Jogos">
    <div class="modalidades-lista">
        <a class="@(Model.Game == "all" ? "ativo" : "")" asp-controller="Esports" asp-action="Index" asp-route-game="all">Todos</a>
        <a class="@(Model.Game == "lol" ? "ativo" : "")" asp-controller="Esports" asp-action="Index" asp-route-game="lol">League of Legends</a>
        <a class="@(Model.Game == "valorant" ? "ativo" : "")" asp-controller="Esports" asp-action="Index" asp-route-game="valorant">Valorant</a>
        <a class="@(Model.Game == "cs" ? "ativo" : "")" asp-controller="Esports" asp-action="Index" asp-route-game="cs">Counter-Strike</a>
    </div>
</nav>

<main class="grade" style="grid-template-columns: minmax(0, 1fr);">
    <section class="centro">
        @if (Model.DisplayMode == "api")
        {
            <p class="sub">
                Fonte: @Model.Provider
                @if (Model.AtualizadoEmUtc is DateTime atualizado)
                {
                    <text> · atualizado às @atualizado.ToLocalTime().ToString("HH:mm:ss")</text>
                }
            </p>
            <partial name="_EsportsBloco" model="@(new EsportsBloco("Ao vivo agora", Model.AoVivo, "Nenhuma partida ao vivo no momento.", true))" />
            <partial name="_EsportsBloco" model="@(new EsportsBloco("Próximas partidas", Model.Proximas, "Sem partidas agendadas para hoje."))" />
            <partial name="_EsportsBloco" model="@(new EsportsBloco("Resultados recentes", Model.Recentes, "Sem resultados hoje."))" />
        }
        else if (Model.DisplayMode == "widget" && !string.IsNullOrWhiteSpace(Model.WidgetUrl))
        {
            <p class="sub">@Model.Motivo Exibindo resultados de @Model.Provider.</p>
            <iframe src="@Model.WidgetUrl"
                    width="100%" height="650" loading="lazy"
                    title="Resultados de e-sports"
                    style="border:0;background:#fff"
                    sandbox="allow-scripts allow-same-origin allow-popups"
                    referrerpolicy="strict-origin-when-cross-origin"></iframe>
        }
        else
        {
            <p class="vazio vazio-caixa">Nenhuma fonte de resultados está disponível agora. @Model.Motivo</p>
        }
    </section>
</main>

@section Scripts {
    @if (Model.DisplayMode == "api")
    {
        <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
        <script>
            (function () {
                if (!window.signalR) return;
                var grupo = "@(Model.Game == "all" ? "esports" : Model.Game)";
                var conexao = new signalR.HubConnectionBuilder().withUrl("/hubs/placar").withAutomaticReconnect().build();

                conexao.on("placarAtualizado", function (lista) {
                    lista.forEach(function (p) {
                        var casa = document.querySelector('[data-placar-casa="' + p.chave + '"]');
                        var fora = document.querySelector('[data-placar-fora="' + p.chave + '"]');
                        if (casa) casa.textContent = p.placarCasa;
                        if (fora) fora.textContent = p.placarFora;
                    });
                });

                conexao.start()
                    .then(function () { return conexao.invoke("EntrarNoGrupo", grupo); })
                    .catch(function (e) { console.warn("SignalR:", e); });
            })();
        </script>
    }
}