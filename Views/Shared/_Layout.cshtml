@{
    var controllerAtual = ViewContext.RouteData.Values["controller"] as string ?? "";
    var emCadastro = controllerAtual is "Times" or "Campeonatos";

    var grupo = ViewData["Grupo"] as string ?? (emCadastro ? "" : "esportes");
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SportStats</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topo">
        <a class="logo" asp-controller="Home" asp-action="Index">
            <span class="logo-marca"></span>SPORTSTATS
        </a>

        <form class="busca" role="search" onsubmit="return false">
            <input type="search" aria-label="Buscar times, atletas ou campeonatos" placeholder="Buscar times, atletas..." />
        </form>

        <nav class="cadastros" aria-label="Cadastros">
            <a class="grupo @(controllerAtual == "Times" ? "ativo" : "")" asp-controller="Times" asp-action="Index">Times</a>
            <a class="grupo @(controllerAtual == "Campeonatos" ? "ativo" : "")" asp-controller="Campeonatos" asp-action="Index">Campeonatos</a>
        </nav>

        <nav class="grupos" aria-label="Categorias">
            <a class="grupo @(grupo == "esportes" ? "ativo" : "")" asp-controller="Home" asp-action="Index" asp-route-grupo="esportes">Esportes</a>
            <a class="grupo @(grupo == "esports" ? "ativo" : "")" asp-controller="Home" asp-action="Index" asp-route-grupo="esports">E-sports</a>
        </nav>
    </header>

    @if (TempData["Erro"] is string mensagemErro)
    {
        <div class="alerta alerta-erro" role="alert">@mensagemErro</div>
    }
    @if (TempData["Sucesso"] is string mensagemSucesso)
    {
        <div class="alerta alerta-sucesso" role="status">@mensagemSucesso</div>
    }

    @RenderBody()

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>