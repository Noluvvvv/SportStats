@model CampeonatoFormViewModel
@{
    ViewData["Title"] = "Novo campeonato";
}

<main class="pagina">
    <div class="pagina-topo">
        <h1>Novo campeonato</h1>
    </div>

    <form asp-action="Criar" method="post" class="formulario">
        <div class="campo">
            <label asp-for="Nome"></label>
            <input asp-for="Nome" maxlength="100" />
            <span asp-validation-for="Nome" class="campo-erro"></span>
        </div>

        <div class="campo">
            <label asp-for="Temporada"></label>
            <input asp-for="Temporada" />
            <span asp-validation-for="Temporada" class="campo-erro"></span>
        </div>

        <div class="campo">
            <label asp-for="ModalidadeId"></label>
            <select asp-for="ModalidadeId" asp-items="Model.Modalidades">
                <option value="0">Escolha uma modalidade...</option>
            </select>
            <span asp-validation-for="ModalidadeId" class="campo-erro"></span>
        </div>

        <div class="formulario-acoes">
            <button type="submit" class="botao botao-vermelho">Salvar</button>
            <a class="botao" asp-action="Index">Cancelar</a>
        </div>
    </form>
</main>
