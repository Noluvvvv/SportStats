@model HomeViewModel

@{
    ViewData["Title"] = Model.Grupo == "esports" ? "E-sports" : "Esportes";
    ViewData["Grupo"] = Model.Grupo;
}

<nav class="modalidades" aria-label="Modalidades">
    <div class="modalidades-lista">
        <a class="@(Model.ModalidadeSlug is null ? "ativo" : "")"
           asp-action="Index"
           asp-route-grupo="@Model.Grupo">
            Principais
        </a>

        @foreach (var modalidade in Model.Modalidades)
        {
            <a class="@(Model.ModalidadeSlug == modalidade.Slug ? "ativo" : "")"
               asp-action="Index"
               asp-route-grupo="@modalidade.Grupo"
               asp-route-modalidade="@modalidade.Slug">
                @modalidade.Nome
            </a>
        }
    </div>
</nav>

<main class="grade"
      data-ao-vivo-url="@Url.Action("AoVivo", "Home", new { grupo = Model.Grupo, modalidade = Model.ModalidadeSlug })"
      data-grupo="@Model.Grupo"
      data-modalidade="@Model.ModalidadeSlug">

    <aside class="coluna" aria-label="Competições">
        <h2 class="coluna-titulo">Competições</h2>

        @if (!Model.Competicoes.Any())
        {
            <p class="vazio">Nenhuma competição disponível nas fontes de dados.</p>
        }
        else
        {
            <ul class="lista-competicoes">
                @foreach (var competicao in Model.Competicoes)
                {
                    <li>
                        <a class="@(Model.CampeonatoId == competicao.Chave ? "ativo" : "")"
                           asp-action="Index"
                           asp-route-grupo="@Model.Grupo"
                           asp-route-modalidade="@competicao.ModalidadeSlug"
                           asp-route-campeonato="@competicao.Chave">

                            <span>@competicao.Nome</span>
                            <small>@competicao.ModalidadeNome · @competicao.Fonte</small>
                        </a>
                    </li>
                }
            </ul>
        }
    </aside>

    <section class="centro">
        <partial name="_BlocoPartidas"
                 model="@(new BlocoPartidas(
                    "Ao vivo agora",
                    Model.AoVivo,
                    "Nenhuma partida ao vivo no momento.",
                    true))" />

        <partial name="_BlocoPartidas"
                 model="@(new BlocoPartidas(
                    "Próximas partidas",
                    Model.Proximas,
                    "Sem partidas agendadas."))" />

        <partial name="_BlocoPartidas"
                 model="@(new BlocoPartidas(
                    "Resultados recentes",
                    Model.Recentes,
                    "Sem resultados recentes disponíveis."))" />
    </section>

    <aside class="coluna" aria-label="Informações das fontes">
        <h2 class="coluna-titulo">Fontes de dados</h2>

        <div class="campeonato">
            <h3 class="campeonato-nome">ESPN</h3>
            @if (Model.AtualizacaoEspn.HasValue)
            {
                <p class="vazio">
                    Atualizado:
                    @Model.AtualizacaoEspn.Value.ToLocalTime().ToString("dd/MM HH:mm:ss")
                </p>
            }
            else
            {
                <p class="vazio">Aguardando dados da ESPN.</p>
            }
        </div>

        <div class="campeonato">
            <h3 class="campeonato-nome">PandaScore</h3>
            @if (Model.AtualizacaoPandaScore.HasValue)
            {
                <p class="vazio">
                    Atualizado:
                    @Model.AtualizacaoPandaScore.Value.ToLocalTime().ToString("dd/MM HH:mm:ss")
                </p>
            }
            else
            {
                <p class="vazio">Aguardando dados da PandaScore.</p>
            }
        </div>

        <div class="campeonato">
            <h3 class="campeonato-nome">Classificação</h3>
            <p class="vazio">
                Classificações e rankings serão exibidos quando disponibilizados
                pelas fontes de dados.
            </p>
        </div>
    </aside>
</main>
