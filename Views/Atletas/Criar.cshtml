@model AtletaFormViewModel

@{
    ViewData["Title"] = "Novo atleta";
}

<main class="pagina">
    <div class="pagina-topo">
        <h1>Novo atleta</h1>
    </div>

    <form asp-action="Criar" method="post" class="formulario">
        <div class="campo">
            <label asp-for="Nome"></label>
            <input asp-for="Nome" maxlength="100" />
            <span asp-validation-for="Nome" class="campo-erro"></span>
        </div>

        <div class="campo">
            <label asp-for="Nickname"></label>
            <input asp-for="Nickname" maxlength="50" />
            <span asp-validation-for="Nickname" class="campo-erro"></span>
        </div>

        <div class="campo">
            <label asp-for="Nacionalidade"></label>
            <input asp-for="Nacionalidade" maxlength="50" />
            <span asp-validation-for="Nacionalidade" class="campo-erro"></span>
        </div>

        <div class="campo">
            <label asp-for="ModalidadeId"></label>
            <select asp-for="ModalidadeId" asp-items="Model.Modalidades">
                <option value="0">Selecione uma modalidade</option>
            </select>
            <span asp-validation-for="ModalidadeId" class="campo-erro"></span>
        </div>

        <div class="formulario-acoes">
            <button type="submit" class="botao botao-vermelho">Salvar</button>
            <a class="botao" asp-action="Index">Cancelar</a>
        </div>
    </form>
</main>